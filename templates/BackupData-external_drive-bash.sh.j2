# {{ ansible_managed }}

#jinja2: trim_blocks:False
#!/bin/sh

# This will backup data to another drive

BACKUP_LOCATION={{ backup_mount_point }}
BACKUP_SOURCE={{ backup_directory['dir_name'] }}

mount {{ backup_external_drive[0]['mount_point'] }}

if [ $? -eq 0 ]; then
	# NO PROBLEMS MOUNTING THE DRIVE
	SHOW_STOPPER=1
else
	SHOW_STOPPER=0
fi

if [ $SHOW_STOPPER -eq 1 ]; then
	# NO ISSUES MOUNTING THE DRIVE; CONTINUE
	while read -r QUEUED_BACKUP
		do
			BACKUP_REMOTE_HOST=$(gawk -F '/' '{ print $1 }' <<< $QUEUE_BACKUP)
			BACKUP_DATE=$(gawk -F '/' '{ print $2 }' <<< $QUEUE_BACKUP)
			rsync -a $BACKUP_SOURCE/$BACKUP_REMOTE_HOST/$BACKUP_REMOTE_DATE $BACKUP_LOCATION/$BACKUP_REMOTE_HOST
		done < {{ backup_queue_filepath }}
	# zero the backup queue file
	echo "" > {{ backup_queue_filepath }}
	umount {{ backup_external_drive[0]['mount_point'] }}
	RETURN_VAL=0
else
	RETURN_VAL=1
fi

exit $RETURN_VAL
