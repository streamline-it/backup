# {{ ansible_managed }}

#jinja2: trim_blocks:False
#!/bin/sh

# This will backup data to another drive

BackupLocation={{ backup_mount_point }}
BACKUP_SOURCE={{ backup_directory['dir_name'] }}

mount {{ backup_external_drive[0]['mount_point'] }}

if [ $? -eq 0 ]; then
	# NO PROBLEMS MOUNTING THE DRIVE
	SHOW_STOPPER=1
else
	SHOW_STOPPER=0
fi

if [ $SHOW_STOPPER_ERROR -eq 1 ]; then
	# NO ISSUES MOUNTING THE DRIVE; CONTINUE
	while read -r QUEUED_BACKUP
		do
			rsync -a $BACKUP_SOURCE/$QUEUED_BACKUP $BACKUP_LOCATION/$QUEUED_BACKUP
		done < {{ backup_queue_filepath }}
	# zero the backup queue file
	echo "" > {{ backup_queue_filepath }}
	unmount {{ backup_external_drive[0]['mount_point'] }}
	RETURN_VAL=0
else
	RETURN_VAL=1
fi

exit $RETURN_VAL
