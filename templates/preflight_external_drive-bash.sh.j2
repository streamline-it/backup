# {{ ansible_managed }}

function check_backup_space() {

	BACKUP_DATA_FLAG_PATH="{{ backup_script_directory }}/BackupDataFlag"
	FREE_BACKUP_SPACE=$(df {{ backup_mount_point }} | awk 'NR >1 { print $4 }')
	BACKUP_SOURCE="$1"

	SOURCE_DIR_SPACE=$(du -s $BACKUP_SOURCE | awk ' { print $1 }')
	
	if [ $FREE_BACKUP_SPACE -gt $SOURCE_DIR_SPACE ]; then
		SUFFICIENT_SPACE=0
	else
		SUFFICIENT_SPACE=1
	fi
	
	
	return 0
}

#!/bin/bash
#*****************************************************************************************
#                              Managed by Ansible
#*****************************************************************************************

SUFFICIENT_SPACE=1
BACKUP_DIRECTORY={{ backup_external_drive[0]['mount_point'] }}
VIRUS_STAT=""
TOT_BACKUP_SPACE=0
QUEUE_FILE_PATH={{ backup_queue_filepath }}
SOURCE_BACKUP_FILEPATH={{ backup_directory['dir_name'] }}

# mount backup drive

mount {{ backup_external_drive[0]['mount_point'] }}

cd {{ backup_script_directory }}

# Make sure the data has no viruses, check that status

if [ -f {{ backup_script_directory }}/virus_scan_status.txt ]; then
	VIRUS_STAT=$(cat {{ backup_script_directory }}/virus_scan_status.txt)
fi


while read -r CURR_BACKUP_FILEPATH
	do
		# check_backup_space for CURR_BACKUP_FILEPATH


		SUFFICIENT_SPACE=1
		REMOTE_HOST=$(awk -F"/" '{ print $1 }'<<< $CURR_BACKUP_FILEPATH)
		if [ $SUFFICIENT_SPACE -eq 1 ] && [ $VIRUS_STAT == "CLEAN" ]; then
			check_backup_space $SOURCE_BACKUP_FILEPATH/$CURR_BACKUP_FILEPATH
			SPACE_NEEDED=$[ $SPACE_NEEDED + $SOURCE_DIR_SPACE ]
			TOT_BACKUP_SPACE=$[ $TOT_BACKUP_SPACE+$SPACE_NEEDED ]
		fi

		# now purge prior backups if there's not enough space for current backup

		TOT_FREE_BACKUP=$(df {{ backup_external_drive[0]['mount_point'] }} | awk 'NR >1 { print $4 }')

		if [ $TOT_BACKUP_SPACE -gt $TOT_FREE_BACKUP ]; then
			for CURR_DIRECTORY in $( find $BACKUP_DIRECTORY/$REMOTE_HOST -maxdepth 1 -type d -exec basename {} \;| grep "^[0-9]" | sort)
				do
					CURR_FREE_SPACE=$(df {{ backup_external_drive[0]['mount_point'] }} | awk 'NR >1 { print $4 }')
					if [ $TOT_BACKUP_SPACE -gt $CURR_FREE_SPACE ]; then
						SUFFICIENT_SPACE=1
						grep '^[0-9]' <<< $CURR_DIRECTORY >/dev/null
						if [ $? -eq 0 ]; then
							rm -Rfv $BACKUP_DIRECTORY"/"$REMOTE_HOST"/"$CURR_DIRECTORY >/dev/null
						fi
					else
						SUFFICIENT_SPACE=0
						break
					fi
				done
		else
			SUFFICIENT_SPACE=0
		fi
	done < $QUEUE_FILE_PATH



echo $SUFFICIENT_SPACE > {{ backup_script_directory }}/free_space_for_backup.txt


# if we have enough space for the backup and it's virus free, run the backup


if [ $SUFFICIENT_SPACE -eq 0 ] && [ $VIRUS_STAT == "CLEAN" ]; then
	unmount {{ backup_mount_point }}
	sleep 2
	bash {{ backup_script_directory }}/BackupData_to_external.sh
	exit 0
else	
	umount {{ backup_mount_point }}
	exit 1
fi
