#jinja2:trip_blocks:False
# {{ ansible_managed }}

function check_backup_space() {

	FREE_BACKUP_SPACE=$(df {{ backup_mount_point }} | awk 'NR >1 { print $4 }')
	BACKUP_SOURCE="$1"

	SOURCE_DIR_SPACE=$(du -s $BACKUP_SOURCE | awk ' { print $1 }')
	
	if [ $FREE_BACKUP_SPACE -gt $SOURCE_DIR_SPACE ]; then
		SUFFICIENT_SPACE=0
	else
		SUFFICIENT_SPACE=1
	fi
	
	
	return 0
}

#!/bin/bash
#*****************************************************************************************
#                              Managed by Ansible
#*****************************************************************************************

SUFFICIENT_SPACE=1
BACKUP_DIRECTORY={{ backup_mount_point }}/{{ backup_remote_hostname }}
TOT_BACKUP_SPACE=0

# mount backup share if necessary

mount {{ backup_mount_point }}

cd {{ backup_script_directory }}

{% for item in backup_locations_to_backup -%}
{% if item['source_mounted'] == true -%}

# check_backup_space for {{ item['source_path'] }}


SUFFICIENT_SPACE=1

if [ $SUFFICIENT_SPACE -eq 1 ] && [ $VIRUS_STAT == "CLEAN" ]; then
{% if item['file_copy'] == true -%}
	FILE_SIZE=$(stat -c %s {{ item['file_path'] }})
	SPACE_NEEDED=$[ $SPACE_NEEDED + $FILE_SIZE ]
{% else -%}

	BACKUP_TYPE="{{ item['backup_type'] }}"
	if [ $BACKUP_TYPE == 'partial' ] || ( [ $BACKUP_TYPE == "full" ] && [ $DAY_OF_MONTH == "01" ] ); then
		check_backup_space {{ item['source_path'] }}
		SPACE_NEEDED=$[ $SPACE_NEEDED + $SOURCE_DIR_SPACE ]
		TOT_BACKUP_SPACE=$[ $TOT_BACKUP_SPACE+$SPACE_NEEDED ]
	fi

{% endif -%}
fi

{% endif -%}
{% endfor -%}

# now purge prior backups if there's not enough space for current backup

TOT_FREE_BACKUP=$(df {{ backup_mount_point }} | awk 'NR >1 { print $4 }')

if [ $TOT_BACKUP_SPACE -gt $TOT_FREE_BACKUP ]; then
	for CURR_DIRECTORY in $( find $BACKUP_DIRECTORY -maxdepth 1 -type d -exec basename {} \;| grep "^[0-9]" | sort)
		do
			CURR_FREE_SPACE=$(df {{ backup_mount_point }} | awk 'NR >1 { print $4 }')
			if [ $TOT_BACKUP_SPACE -gt $CURR_FREE_SPACE ]; then
				SUFFICIENT_SPACE=1
				grep '^[0-9]' <<< $CURR_DIRECTORY >/dev/null
				if [ $? -eq 0 ]; then
					rm -Rfv $BACKUP_DIRECTORY"/"$CURR_DIRECTORY >/dev/null
				fi
			else
				SUFFICIENT_SPACE=0
				break
			fi
		done
else
	SUFFICIENT_SPACE=0
fi



echo $SUFFICIENT_SPACE > {{ backup_script_directory }}/free_space_for_backup.txt


# if we have enough space for the backup and it's virus free, run the backup


if [ $SUFFICIENT_SPACE -eq 0 ] && [ $VIRUS_STAT == "CLEAN" ]; then
	bash {{ backup_script_directory }}/BackupData.sh R 0
	umount {{ backup_mount_point }}
	exit 0
else	
	umount {{ backup_mount_point }}
	exit 1
fi
